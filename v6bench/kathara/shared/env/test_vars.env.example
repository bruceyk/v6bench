# test_vars.env.example -- copy to v6bench/kathara/shared/env/test_vars.env
#
# v6bench/scanapi_conversor.sh generates this file on every run: it greps the
# variable names out of scanapi.yaml, writes one `export VAR=""` line for each,
# then appends BASE_DOMAIN and BASE_PROTO. Re-running the converter OVERWRITES
# your values (BASE_DOMAIN back to "", BASE_PROTO back to "https").
#
# BASE_URL is deliberately NOT configured here. shared/shared_data/test_runner.sh
# builds it per view at container start:
#   BASE_URL="${BASE_PROTO}://${sdom}.lab.${BASE_DOMAIN}"
# so an API path prefix such as /v2 or /v1 has to be part of the spec paths, not
# of a variable. (The converter filters BASE_URL out of this file for that reason.)
#
# BASE_DOMAIN must be the same domain passed to zonefile_creator.py, because the
# zone file it generates is what {view}.lab.<domain> resolves against.
export BASE_DOMAIN="api.apis.guru"

# http or https. Use http inside the lab: the view hostnames are fake, and CDNs
# reject them at the TLS SNI stage (handshake failure, alert 552) before any
# certificate is looked at -- scanapi's verify: false cannot rescue it.
export BASE_PROTO="http"
